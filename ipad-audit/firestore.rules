rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function action(id) { return get(/databases/$(database)/documents/actions/$(id)).data; }
    function participant(id) { return signedIn() && mail() in action(id).participantEmails; }
    function lead(id) { return admin() || (participant(id) && mail() == action(id).coordinatorEmail); }
    function assigned(id, classId) {
      return participant(id) &&
        get(/databases/$(database)/documents/actions/$(id)/assignments/$(classId)).data.teacherEmail == mail();
    }
    function onlyProgress(id) {
      let changed = request.resource.data.progress.diff(resource.data.progress).affectedKeys();
      let classId = changed.toList()[0];
      return changed.size() == 1 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['progress', 'updatedAt']) &&
        assigned(id, classId) &&
        request.resource.data.progress[classId].keys().hasOnly(['total','checked','done']) &&
        request.resource.data.progress[classId].total == resource.data.progress[classId].total &&
        request.resource.data.progress[classId].checked is int &&
        request.resource.data.progress[classId].checked >= 0 &&
        request.resource.data.progress[classId].checked <= resource.data.progress[classId].total &&
        request.resource.data.progress[classId].done ==
          (request.resource.data.progress[classId].checked == resource.data.progress[classId].total);
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /actions/{id} {
      allow get, list: if admin() || (signedIn() && mail() in resource.data.participantEmails);
      allow create: if admin() &&
        request.resource.data.keys().hasAll(['title','date','grade','coordinatorEmail','participantEmails','classes','progress','status']) &&
        request.resource.data.status == 'active';
      allow update: if (lead(id) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
        request.resource.data.status in ['active','completed']) || onlyProgress(id);
      allow delete: if false;
      match /assignments/{classId} {
        allow get, list: if lead(id) || assigned(id,classId);
        allow create: if admin() &&
          getAfter(/databases/$(database)/documents/actions/$(id)).data.classes.size() > 0 &&
          request.resource.data.keys().hasAll(['teacherEmail','roster','sampleCount','selected','records']);
        allow update: if assigned(id,classId) && action(id).status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selected','replacementLog','records','updatedAt']) &&
          request.resource.data.teacherEmail == resource.data.teacherEmail &&
          request.resource.data.roster == resource.data.roster &&
          request.resource.data.sampleCount == resource.data.sampleCount;
        allow delete: if false;
      }
    }
  }
}
