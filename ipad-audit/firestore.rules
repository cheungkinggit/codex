rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function mail() { return request.auth.token.email.lower(); }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function action(id) { return get(/databases/$(database)/documents/actions/$(id)).data; }
    function participant(id) { return signedIn() && mail() in action(id).participantEmails; }
    function lead(id) { return admin() || (participant(id) && mail() == action(id).coordinatorEmail); }
    function assigned(id, classId) {
      return participant(id) &&
        get(/databases/$(database)/documents/actions/$(id)/assignments/$(classId)).data.teacherEmail == mail();
    }
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /actions/{id} {
      allow get, list: if admin() || (signedIn() && mail() in resource.data.participantEmails);
      allow create: if admin() &&
        request.resource.data.keys().hasAll(['title','date','grade','coordinatorEmail','participantEmails','classes','status']) &&
        request.resource.data.status == 'active';
      allow update: if (lead(id) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']) &&
        request.resource.data.status in ['active','completed']);
      allow delete: if false;
      match /progress/{classId} {
        allow get, list: if participant(id) || admin();
        allow create: if admin() &&
          getAfter(/databases/$(database)/documents/actions/$(id)).data.classes.size() > 0 &&
          request.resource.data.keys().hasOnly(['total','checked','done','teacherEmail']) &&
          request.resource.data.checked == 0 && request.resource.data.done == false;
        allow update: if assigned(id,classId) && action(id).status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked','done']) &&
          request.resource.data.checked is int &&
          request.resource.data.checked >= 0 && request.resource.data.checked <= resource.data.total &&
          request.resource.data.done == (request.resource.data.checked == resource.data.total);
        allow delete: if false;
      }
      match /assignments/{classId} {
        allow get, list: if lead(id) || assigned(id,classId);
        allow create: if admin() &&
          getAfter(/databases/$(database)/documents/actions/$(id)).data.classes.size() > 0 &&
          request.resource.data.keys().hasAll(['teacherEmail','roster','sampleCount','selected','records']);
        allow update: if assigned(id,classId) && action(id).status == 'active' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selected','replacementLog','records','updatedAt']) &&
          request.resource.data.teacherEmail == resource.data.teacherEmail &&
          request.resource.data.roster == resource.data.roster &&
          request.resource.data.sampleCount == resource.data.sampleCount;
        allow delete: if false;
      }
    }
  }
}
